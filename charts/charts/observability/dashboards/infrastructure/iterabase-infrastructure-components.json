        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (increase(pg_stat_database_deadlocks{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": true,
          "instant": false
        }
