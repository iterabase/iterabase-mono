  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "API request rate by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(control_plane_http_requests_total{namespace=~\"$namespace\",component=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "title": "API server error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(control_plane_http_requests_total{namespace=~\"$namespace\",component=\"api\",status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(control_plane_http_requests_total{namespace=~\"$namespace\",component=\"api\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "API P95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(control_plane_http_request_duration_seconds_bucket{namespace=~\"$namespace\",component=\"api\"}[$__rate_interval])))",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Manager reconciliation errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (controller) (rate(controller_runtime_reconcile_total{namespace=~\"$namespace\",result=\"error\",component=\"manager\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Manager workqueue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (workqueue_depth{namespace=~\"$namespace\",job=\"control-plane\"})",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Database pool utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "control_plane_database_pool_connections{namespace=~\"$namespace\",state=\"total\"} / clamp_min(control_plane_database_pool_max_connections{namespace=~\"$namespace\"}, 1)",
          "legendFormat": "{{component}} {{model}} {{route}} {{result}} {{pod}}",
          "range": true,
          "instant": false
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "iterabase",
    "production",
    "platform"
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"control-plane|inference-gateway|postgresql|minio|.*dcgm-exporter.*\"}, namespace)",
          "refId": "VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
