[
  {
    "name": "docs only selects no expensive owner",
    "paths": ["README.md", "docs/ci.md", "control-plane/README.md"],
    "true": [],
    "images": []
  },
  {
    "name": "control-plane Go stays with its owner",
    "paths": ["control-plane/internal/api/server.go"],
    "true": ["control_plane", "images"],
    "images": ["control-plane"]
  },
  {
    "name": "control-plane Makefile retains Go and required harness gates",
    "paths": ["control-plane/Makefile"],
    "true": ["control_plane", "harness", "images"],
    "images": ["control-plane"]
  },
  {
    "name": "dashboard selects UI and its embedded image",
    "paths": ["control-plane/ui/src/App.tsx"],
    "true": ["control_plane", "ui", "images"],
    "images": ["control-plane"]
  },
  {
    "name": "protobuf contract fans out to generated consumers",
    "paths": ["control-plane/proto/iterabase/harness/v1/harness.proto"],
    "true": ["control_plane", "harness", "tool_runner", "proto", "forge_e2e", "forge_real_e2e", "images"],
    "images": ["control-plane", "control-plane-harness", "control-plane-tool-runner"]
  },
  {
    "name": "harness isolation selects both harness images",
    "paths": ["control-plane/harness/isolation/launcher.sh"],
    "true": ["harness", "images"],
    "images": ["control-plane-harness", "control-plane-harness-isolation"]
  },
  {
    "name": "inference gateway selects gateway and image",
    "paths": ["inference-gateway/internal/proxy/handler.go"],
    "true": ["inference_gateway", "images"],
    "images": ["inference-gateway"]
  },
  {
    "name": "Forge release metadata does not select E2E",
    "paths": ["forge/.goreleaser.yaml"],
    "true": ["forge"],
    "images": []
  },
  {
    "name": "Forge source selects unit and current E2E parity suite",
    "paths": ["forge/internal/lifecycle/apply.go"],
    "true": ["forge", "forge_e2e", "forge_real_e2e"],
    "images": []
  },
  {
    "name": "charts fan out to chart and source-composed Kind owners",
    "paths": ["charts/charts/control-plane/templates/deployment.yaml"],
    "true": ["forge_e2e", "charts"],
    "images": []
  },
  {
    "name": "root workspace contract fans out to every owner",
    "paths": ["go.work.sum"],
    "true": ["control_plane", "ui", "harness", "tool_runner", "proto", "inference_gateway", "forge", "forge_e2e", "forge_real_e2e", "charts", "nested_go_lint", "images"],
    "images": ["control-plane", "control-plane-harness", "control-plane-harness-isolation", "control-plane-tool-runner", "inference-gateway"]
  },
  {
    "name": "release implementation runs focused contract checks only",
    "paths": [
      ".github/workflows/release-candidate.yml",
      ".github/workflows/release-promote.yml",
      ".github/scripts/release.py",
      "release/targets.json",
      "forge/VERSION"
    ],
    "true": [],
    "images": []
  },
  {
    "name": "affected-target selector changes fan out to every owner",
    "paths": [".github/scripts/select_ci.py"],
    "true": ["control_plane", "ui", "harness", "tool_runner", "proto", "inference_gateway", "forge", "forge_e2e", "forge_real_e2e", "charts", "nested_go_lint", "images"],
    "images": ["control-plane", "control-plane-harness", "control-plane-harness-isolation", "control-plane-tool-runner", "inference-gateway"]
  },
  {
    "name": "cross-component PR unions owners",
    "paths": ["control-plane/harness/src/index.ts", "inference-gateway/internal/auth/auth.go"],
    "true": ["harness", "inference_gateway", "images"],
    "images": ["control-plane-harness", "inference-gateway"]
  },
  {
    "name": "shared E2E testkit fans out to every owner and suite",
    "paths": ["testkit/e2e/suite.go"],
    "true": ["control_plane", "ui", "harness", "tool_runner", "proto", "inference_gateway", "forge", "forge_e2e", "forge_real_e2e", "charts", "nested_go_lint", "images"],
    "images": ["control-plane", "control-plane-harness", "control-plane-harness-isolation", "control-plane-tool-runner", "inference-gateway"]
  },
  {
    "name": "charts E2E module selects its dedicated Go lint owner",
    "paths": ["charts/test/e2e/metallb_transition_test.go"],
    "true": ["charts", "forge_e2e", "nested_go_lint"],
    "images": []
  },
  {
    "name": "control-plane E2E module selects its dedicated Go lint owner",
    "paths": ["control-plane/test/e2e/e2e_test.go"],
    "true": ["control_plane", "nested_go_lint", "images"],
    "images": ["control-plane"]
  },
  {
    "name": "Forge E2E module selects its dedicated Go lint owner",
    "paths": ["forge/test/e2e/e2e_test.go"],
    "true": ["forge", "forge_e2e", "forge_real_e2e", "nested_go_lint"],
    "images": []
  },
  {
    "name": "Forge linter configuration selects the nested Go lint owner it governs",
    "paths": ["forge/.golangci.yml"],
    "true": ["forge", "nested_go_lint"],
    "images": []
  },
  {
    "name": "control-plane linter configuration selects the nested Go lint owner it governs",
    "paths": ["control-plane/.golangci.yml"],
    "true": ["control_plane", "nested_go_lint", "images"],
    "images": ["control-plane"]
  }
]
