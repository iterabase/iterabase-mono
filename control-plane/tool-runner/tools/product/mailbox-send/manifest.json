{
  "apiVersion": "iterabase.io/tool/v1",
  "name": "platform.mailbox.send",
  "version": "1.0.0",
  "digest": "sha256:e0b3b5001ec73b7e8fa980beef95424ad3bf6afbb5011b5504ae3479d5af4d04",
  "description": "Send one email, or one reply to a received message, as a bound Microsoft 365 mailbox. Returns the sent message's internetMessageId and conversationId for reply matching.",
  "bundle": "index.mjs",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mailbox", "to", "subject", "body"],
    "properties": {
      "mailbox": { "type": "string", "minLength": 3, "maxLength": 320 },
      "to": { "type": "string", "minLength": 3, "maxLength": 320, "pattern": "^[^@\\s,;<>]+@[^@\\s,;<>]+$" },
      "subject": { "type": "string", "minLength": 1, "maxLength": 255 },
      "body": { "type": "string", "maxLength": 32768 },
      "bodyType": { "type": "string", "enum": ["text", "html"] },
      "replyToMessageId": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "effectClass": "non_idempotent_write",
  "credentialSlots": [
    { "name": "microsoft365", "scheme": "oauth_client_credentials", "required": true }
  ],
  "timeoutMs": 30000,
  "consequenceSummaryTemplate": {
    "localizedTemplates": {
      "en": "Send the email \"{{subject}}\" from {{mailbox}} to {{to}}",
      "pt": "Enviar o email \"{{subject}}\" de {{mailbox}} para {{to}}"
    },
    "argumentPaths": { "subject": "/subject", "mailbox": "/mailbox", "to": "/to" }
  }
}
